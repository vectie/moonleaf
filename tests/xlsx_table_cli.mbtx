}

///|
extern "js" fn verify(args : Array[String]) -> Unit =
  #|args => {
  #| const fs=require('node:fs'),cp=require('node:child_process'),path=require('node:path'),assert=require('node:assert/strict'),crypto=require('node:crypto');
  #| const [cli,preview,out]=args;if(!out)throw Error('Expected XLSX table CLI, preview CLI, fresh directory');fs.mkdirSync(out,{recursive:false});
  #| const save=(n,b)=>{const p=path.join(out,n);fs.writeFileSync(p,b);return p},json=(n,v)=>save(n,JSON.stringify(v,null,2)+'\n');
  #| const crc=b=>{let c=0xffffffff;for(const v of b){c^=v;for(let k=0;k<8;k++)c=(c>>>1)^((c&1)?0xedb88320:0)}return (c^0xffffffff)>>>0};
  #| const zip=parts=>{const local=[],central=[];let offset=0;for(const [name,text] of Object.entries(parts)){const n=Buffer.from(name),b=Buffer.from(text),l=Buffer.alloc(30),c=Buffer.alloc(46);l.writeUInt32LE(0x04034b50);l.writeUInt16LE(20,4);l.writeUInt32LE(crc(b),14);l.writeUInt32LE(b.length,18);l.writeUInt32LE(b.length,22);l.writeUInt16LE(n.length,26);c.writeUInt32LE(0x02014b50);c.writeUInt16LE(20,4);c.writeUInt16LE(20,6);c.writeUInt32LE(crc(b),16);c.writeUInt32LE(b.length,20);c.writeUInt32LE(b.length,24);c.writeUInt16LE(n.length,28);c.writeUInt32LE(offset,42);local.push(l,n,b);central.push(c,n);offset+=l.length+n.length+b.length}const cd=Buffer.concat(central),e=Buffer.alloc(22);e.writeUInt32LE(0x06054b50);e.writeUInt16LE(Object.keys(parts).length,8);e.writeUInt16LE(Object.keys(parts).length,10);e.writeUInt32LE(cd.length,12);e.writeUInt32LE(offset,16);return Buffer.concat([...local,cd,e])};
  #| const ns='http://schemas.openxmlformats.org/spreadsheetml/2006/main',rel='http://schemas.openxmlformats.org/officeDocument/2006/relationships';
  #| const s=(r,t)=>`<c r="${r}" t="inlineStr"><is><t xml:space="preserve">${t}</t></is></c>`;
  #| const sheet=`<worksheet xmlns="${ns}"><sheetData><row r="1"><c r="A1"><f>1+1</f><v>2</v></c></row><row r="2"><c r="A2" t="e"><v>#N/A</v></c></row><row r="3">${['id','name','amount','active','serial','note'].map((h,i)=>s(String.fromCharCode(66+i)+'3',h)).join('')}</row><row r="4"><c r="B4" t="s"><v>0</v></c>${s('C4','Acme')}<c r="D4"><v>12.50</v></c><c r="E4" t="b"><v>1</v></c><c r="F4" s="1"><v>60</v></c>${s('G4','=1+1')}</row><row r="5">${s('B5','002')}${s('C5','Blue')}<c r="D5"><v>2</v></c><c r="E5" t="b"><v>false</v></c><c r="F5" s="1"><v>61</v></c>${s('G5','')}</row><row r="7">${s('B7','003')}${s('C7','東京 🐈')}<c r="D7"><v>-3</v></c><c r="E7" t="b"><v>true</v></c>${s('G7','a,&quot;b&quot;\nnext')}</row></sheetData><mergeCells><mergeCell ref="J10:K11"/></mergeCells></worksheet>`;
  #| const parts={'[Content_Types].xml':`<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types"><Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/><Default Extension="xml" ContentType="application/xml"/><Override PartName="/xl/workbook.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"/><Override PartName="/xl/worksheets/cover.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/><Override PartName="/xl/worksheets/data.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/><Override PartName="/xl/sharedStrings.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sharedStrings+xml"/><Override PartName="/xl/styles.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.styles+xml"/></Types>`,'_rels/.rels':`<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="root" Type="${rel}/officeDocument" Target="xl/workbook.xml"/></Relationships>`,'xl/workbook.xml':`<workbook xmlns="${ns}" xmlns:r="${rel}"><workbookPr date1904="0"/><sheets><sheet name="Cover" sheetId="1" r:id="cover"/><sheet name="Sales &amp; Returns" sheetId="2" r:id="data"/></sheets></workbook>`,'xl/_rels/workbook.xml.rels':`<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="cover" Type="${rel}/worksheet" Target="worksheets/cover.xml"/><Relationship Id="data" Type="${rel}/worksheet" Target="worksheets/data.xml"/><Relationship Id="strings" Type="${rel}/sharedStrings" Target="sharedStrings.xml"/><Relationship Id="styles" Type="${rel}/styles" Target="styles.xml"/></Relationships>`,'xl/worksheets/cover.xml':`<worksheet xmlns="${ns}"><sheetData><row>${s('A1','Read the selected range')}</row></sheetData></worksheet>`,'xl/worksheets/data.xml':sheet,'xl/sharedStrings.xml':`<sst xmlns="${ns}" count="1" uniqueCount="1"><si><t>001</t></si></sst>`,'xl/styles.xml':`<styleSheet xmlns="${ns}"><cellXfs count="2"><xf numFmtId="0"/><xf numFmtId="14"/></cellXfs></styleSheet>`,'custom/original.txt':'retained original'};
  #| const input=save('source.xlsx',zip(parts));const selection={sheet:'Sales & Returns',range:'B3:G8',header:'first_row'},spec=json('selection.json',selection);
  #| const recipe={version:1,filters:[{column:'active',mode:'boolean',op:'eq',value:true}],sort:[{column:'amount',mode:'number',direction:'desc',blanks:'last'}],select:['id','name','amount','active','serial','note'],limit:100};const query=json('query.json',recipe);
  #| const hash=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex');const before=[input,spec,query].map(hash);
  #| const run=(src=input,sel=spec,q=query,format='json')=>cp.spawnSync(process.execPath,[cli,src,sel,q,format],{maxBuffer:16000000,timeout:15000});
  #| const good=(...a)=>{const r=run(...a);assert.equal(r.status,0,r.stderr.toString());const report=JSON.parse(r.stderr);assert.equal(report.warnings.length,3);return [r.stdout,report]};
  #| const refusals=[];const bad=(label,...a)=>{const r=run(...a);assert.notEqual(r.status,0,label);assert.equal(r.stdout.length,0,label);assert.ok(r.stderr.length,label);refusals.push({case:label,stderr:r.stderr.toString()})};
  #| const expected=[{id:'001',name:'Acme',amount:12.5,active:true,serial:60,note:'=1+1'},{id:'003',name:'東京 🐈',amount:-3,active:true,note:'a,"b"\nnext'}];
  #| const rows=[recipe.select,['001','Acme','12.50','true','60','=1+1'],['003','東京 🐈','-3','true','','a,"b"\nnext']];
  #| for(const format of ['json','csv','xlsx']){const [bytes,report]=good(input,spec,query,format);assert.deepEqual(report.worksheet_rows,[4,7]);assert.equal(report.input_rows,5);const p=save('selected.'+format,bytes);json('report-'+format+'.json',report);if(format==='json')assert.deepEqual(JSON.parse(bytes),expected);const r=cp.spawnSync(process.execPath,[preview,p],{encoding:'utf8'});assert.equal(r.status,0,r.stderr);save('reopened-'+format+'.json',r.stdout);const actual=JSON.parse(r.stdout).sheets[0].rows.map(row=>row.map(v=>v==='TRUE'?'true':v==='FALSE'?'false':v));const wanted=structuredClone(rows);if(format==='json')wanted[1][2]='12.5';assert.deepEqual(actual,wanted);if(format==='xlsx'){const z=cp.spawnSync('unzip',['-t',p],{encoding:'utf8'});assert.equal(z.status,0);save('xlsx-integrity.txt',z.stdout);const xml=cp.spawnSync('unzip',['-p',p,'xl/worksheets/sheet1.xml'],{encoding:'utf8'});assert.equal(xml.status,0);assert.ok(!xml.stdout.includes('<f'));save('exported-sheet.xml',xml.stdout);const reopen=json('reopen-selection.json',{sheet:'JSON data',range:'A1:F3',header:'first_row'});assert.deepEqual(JSON.parse(good(p,reopen,'-')[0]),expected);}}
  #| const [raw,rawReport]=good(input,spec,'-');const rawRows=JSON.parse(raw);assert.equal(rawRows.length,5);assert.deepEqual(rawRows[2],{});assert.deepEqual(rawRows[4],{});assert.equal(rawRows[1].note,'');assert.equal(rawRows[1].active,false);assert.deepEqual(rawReport.worksheet_rows,[4,5,6,7,8]);save('unfiltered.json',raw);
  #| const headers=json('explicit-headers.json',{sheet:selection.sheet,range:'B4:G5',header:recipe.select});assert.equal(JSON.parse(good(input,headers,'-')[0]).length,2);
  #| const changed=json('changed-query.json',{...recipe,filters:[{column:'active',mode:'boolean',op:'eq',value:false}]});const [other,otherReport]=good(input,spec,changed);assert.deepEqual(JSON.parse(other).map(r=>r.id),['002']);assert.deepEqual(otherReport.worksheet_rows,[5]);save('changed-output.json',other);
  #| for(const [label,change] of [['missing-sheet',{sheet:'absent'}],['case-sheet',{sheet:'sales & returns'}],['bad-range',{range:'b3:G8'}],['formula',{range:'A1',header:['x']}],['error',{range:'A2',header:['x']}],['merge',{range:'K11',header:['x']}],['duplicate-header',{header:['x','x','a','b','c','d']}],['header-count',{header:['x']}],['oversize-range',{range:'A1:XFD1048576'}],['unknown-field',{typo:1}]])bad(label,input,json(label+'.json',{...selection,...change}));
  #| const mutate=(name,xml)=>save(name+'.xlsx',zip({...parts,'xl/worksheets/data.xml':xml}));
  #| bad('duplicate-cell',mutate('duplicate-cell',sheet.replace('<c r="B4" t="s"><v>0</v></c>','<c r="B4" t="s"><v>0</v></c><c r="B4"/>')));
  #| bad('array-follower',mutate('array-follower',sheet.replace('<f>1+1</f>','<f t="array" ref="A1:G8">1+1</f>')));
