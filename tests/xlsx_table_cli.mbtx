  #| bad('missing-file',path.join(out,'absent'));bad('directory',out);bad('stdin','-');bad('stdin-spec',input,'-');bad('format',input,spec,query,'pdf');bad('bad-zip',save('broken.xlsx','broken'));
  #| const corrupt=Buffer.from(fs.readFileSync(input));corrupt[60]^=1;bad('bad-crc',save('corrupt.xlsx',corrupt));
  #| bad('invalid-spec-utf8',input,save('invalid-spec.json',Buffer.from([0xff])));bad('invalid-query',input,spec,json('invalid-query.json',{...recipe,select:['absent']}));
  #| const oversized=save('oversized.xlsx','');const fd=fs.openSync(oversized,'w');fs.ftruncateSync(fd,8388609);fs.closeSync(fd);bad('byte-limit',oversized);
  #| assert.deepEqual(JSON.parse(good()[0]),expected);assert.deepEqual([input,spec,query].map(hash),before);json('original-sha256.json',{source:before[0],selection:before[1],query:before[2]});json('refusals.json',refusals);
  #| console.log(`PASS: selected multi-sheet non-A1 sparse typed XLSX -> existing query -> CSV/JSON/XLSX -> independent reopen and typed XLSX reimport; changed query and supplied headers; ${refusals.length} fail-closed negative cases; retry succeeds; source/spec/query SHA256 unchanged`);
  #| }

///|
fn main {
  verify(@env.args()[2:].to_array())
}
