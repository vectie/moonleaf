import {
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "vectie/moonleaf",
  "vectie/moonleaf/csv",
  "vectie/moonleaf/jsontable",
  "vectie/moonleaf/docx",
  "vectie/moonleaf/opc",
  "vectie/moonleaf/pdf_text",
  "vectie/moonleaf/pptx",
  "vectie/moonleaf/scene",
  "vectie/moonleaf/xlsx",
}

pkgtype(kind: "executable")

supported_targets = "js+native"

options(
  "native-stub": [ "io_native.c" ],
  targets: {
    "io_js.mbt": [ "js" ],
    "io_native.mbt": [ "native" ],
    "io_native_wbtest.mbt": [ "native" ],
  },
)
